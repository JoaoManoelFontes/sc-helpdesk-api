# PostgreSQL container
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_dev_password

# Spring Boot datasource (used when the application runs directly on the host)
# The API service in compose.yaml overrides DB_URL to use the postgres container hostname.
DB_URL=jdbc:postgresql://localhost:5432/helpdesk
DB_USERNAME=helpdesk
DB_PASSWORD=helpdesk_dev_password
